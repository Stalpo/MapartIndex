doctype html
html
  include includes/head.pug
  body
    include includes/navbar.pug

    .container
      h1.text-center Maps Missing Cross-References
      hr
      if !admin && !mod
        div.alert.alert-danger(role="alert")
          | You are not an administrator or a moderator
      else
        form(method='get', action='/mapart/missingRefs')
          .form-group.text-center
            label.sr-only(for='missingRefType') Filter by record type:
            .input-group.mb-2.mr-sm-2
              .input-group-prepend
                .input-group-text Type
              select#missingRefType.form-control(name='type')
                option(value='mapart' selected=(type === 'mapart')) MapArts without any linked MapIds
                option(value='mapid' selected=(type === 'mapid')) MapIds without a linked MapArt
              .input-group-append
                button.btn.btn-primary(type='submit') Filter

        #emptyState.alert.alert-warning(style="display: none;") No records with missing cross-references found.

        .row#gridContainer.mb-4

        #loadingSpinner.text-center.mt-4
          i.fa.fa-spinner.fa-spin.fa-3x
          p Loading...

        script.
          const missingRefType = "#{type}";
          const perPage = 24;
          let currentPage = 0;
          let loading = false;
          let exhausted = false;
          let observer;

          function buildCard(map) {
            const isMapId = missingRefType === 'mapid';
            const imgSrc = isMapId ? `/public/uploads/${map.imgUrl}` : `/public/uploads/mapart/${map.imgUrl}`;
            const title = map.name || map.displayName || 'No Name';
            const viewHref = isMapId ? `/mapid/id/${map.id}` : `/mapart/id/${map.id}`;
            const editHref = isMapId ? `/mapid/edit/${map.id}` : `/mapart/edit/${map.id}`;

            const col = document.createElement('div');
            col.className = 'col-md-4';
            col.innerHTML = `
              <div class="card mb-4 box-shadow">
                <img class="card-img-top pixelated-image" src="${imgSrc}" alt="Image for ${title}">
                <div class="card-body">
                  <h5 class="card-title">${title}</h5>
                  <p class="card-text">Artist: ${map.artist || 'N/A'}</p>
                  <p class="card-text">Server: ${map.server || 'N/A'}</p>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <a class="btn btn-sm btn-outline-secondary" href="${viewHref}">View</a>
                      <a class="btn btn-sm btn-outline-secondary" href="${editHref}">Edit</a>
                    </div>
                    <small class="text-muted">${new Date(map.createdAt).toLocaleDateString()}</small>
                  </div>
                </div>
              </div>
            `;
            return col;
          }

          function startObservingIntersection() {
            if (observer) observer.disconnect();
            const gridContainer = document.getElementById('gridContainer');
            const lastElement = gridContainer.lastElementChild;
            if (!lastElement) return;

            observer = new IntersectionObserver(entries => {
              if (entries[0].isIntersecting) {
                fetchNextPage();
              }
            }, {
              root: null,
              rootMargin: '200px',
              threshold: 0.0
            });
            observer.observe(lastElement);
          }

          async function fetchNextPage() {
            if (loading || exhausted) return;
            loading = true;
            currentPage++;

            const loadingSpinner = document.getElementById('loadingSpinner');
            loadingSpinner.style.display = 'block';

            try {
              const endpoint = missingRefType === 'mapid' ? '/api/mapId/missingRefs' : '/api/mapArt/missingRefs';
              const url = `${endpoint}?page=${currentPage}&perPage=${perPage}`;
              const response = await fetch(url);

              if (response.status === 404) {
                exhausted = true;
                if (currentPage === 1) {
                  document.getElementById('emptyState').style.display = 'block';
                }
                return;
              }
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }

              const maps = await response.json();
              const gridContainer = document.getElementById('gridContainer');
              maps.forEach(map => gridContainer.appendChild(buildCard(map)));

              if (maps.length < perPage) {
                exhausted = true;
              } else {
                startObservingIntersection();
              }
            } catch (error) {
              console.error('Error fetching maps missing cross-references:', error);
              exhausted = true;
            } finally {
              loading = false;
              loadingSpinner.style.display = 'none';
            }
          }

          fetchNextPage();

    style.
      .pixelated-image {
        image-rendering: pixelated;
      };

    include includes/scripts.pug
