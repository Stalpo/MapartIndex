doctype html
html
  - const pageTitle = "MapArt Stitching"
  include includes/head.pug
  body
    include includes/navbar.pug
    script(src="/public/js/joinImages.js")
    div.container.text-center
      h1= pageTitle
      hr 
      if !admin && !mod
        div.alert.alert-danger(role="alert")
          | You are not an administrator or a moderator
      else
        div#container
          .row
            .col
              div.form-group
                label.sr-only(for='width') Width:
                div.input-group.mb-2.mr-sm-2
                  div.input-group-prepend
                    div.input-group-text Width
                  select#width.form-control
                    for i in [...Array(200).keys()]
                      option(value=`${i+1}`)= `${i+1}`
            .col
              div.form-group
                label.sr-only(for='height') Height:
                div.input-group.mb-2.mr-sm-2
                  div.input-group-prepend
                    div.input-group-text Height
                  select#height.form-control
                    for i in [...Array(200).keys()]
                      option(value=`${i+1}`)= `${i+1}`
            .col
              div.form-group
                label(for='vertfirst', class='mb-2') read vertical before horizontal:
                input(type='checkbox', name='vertfirst', id='vertfirst')
            .col
              div.form-group
                label(for='flipx', class='mb-2') read right to left:
                input(type='checkbox', name='flipx', id='flipx')
            .col
              div.form-group
                label(for='flipy', class='mb-2') read bottom to top:
                input(type='checkbox', name='flipy', id='flipy')
            .col
              div.form-group
                label(for='gridPreview', class='mb-2') Show separate tiles (drag to swap):
                input(type='checkbox', name='gridPreview', id='gridPreview')

          div#inputContainer

          .row
            .col
              div.form-group
                button#fetchImages.btn.btn-primary Fetch and Build MapArt

          hr
          div#outputContainer

      script.
        // Get references to width and height selectors
        const widthSelector = document.getElementById('width');
        const heightSelector = document.getElementById('height');
        const fetchButton = document.getElementById('fetchImages');

        // Get references to reading order checkboxes
        const vertfirstSelector = document.getElementById('vertfirst');
        const flipxSelector = document.getElementById('flipx');
        const flipySelector = document.getElementById('flipy');
        const gridPreviewSelector = document.getElementById('gridPreview');

        let blobObj = undefined;

        // Add event listener to both selectors to handle changes
        widthSelector.addEventListener('change', generateInputs);
        heightSelector.addEventListener('change', generateInputs);

        // catch vars for server and if nsfw
        let idsServer;
        let idsNsfw = false;

        // Function to generate text input boxes based on selected dimensions
        function generateInputs() {
          const width = parseInt(widthSelector.value);
          const height = parseInt(heightSelector.value);
          const totalInputs = width * height;

          const container = document.getElementById('inputContainer');
          container.innerHTML = ''; // Clear previous inputs

          for (let i = 0; i < totalInputs; i++) {
            const inputGroup = document.createElement('div');
            inputGroup.classList.add('form-group', 'row');

            // Create rotation selector
            const rotationSelectorContainer = document.createElement('div');
            rotationSelectorContainer.classList.add('col-2'); // Adjusted width to 20%
            const rotationSelector = document.createElement('select');
            rotationSelector.classList.add('form-control');
            for (let j = 0; j < 4; j++) {
              const option = document.createElement('option');
              option.value = j;
              option.textContent = j;
              rotationSelector.appendChild(option);
            }
            rotationSelectorContainer.appendChild(rotationSelector);
            inputGroup.appendChild(rotationSelectorContainer);

            // Create map name input
            const nameInputContainer = document.createElement('div');
            nameInputContainer.classList.add('col-10'); // Adjusted width to 80%
            const nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.classList.add('form-control');
            nameInput.placeholder = `map name ${i + 1}`;
            nameInputContainer.appendChild(nameInput);
            inputGroup.appendChild(nameInputContainer);

            container.appendChild(inputGroup);
          }
        }

        function fetchImages() {
          return new Promise((resolve, reject) => {
            const inputs = document.querySelectorAll('#inputContainer input');
            const rotations = document.querySelectorAll('#inputContainer select');

            const promises = [];

            inputs.forEach((input, index) => {
              let displayName = input.value;
              // new code to backcheck for last prev defined DN and count up from that (autofill range basically)
              if(!input.value){
                for(let i = index - 1; i >= 0; i--){
                  if(inputs[i].value){
                    const tokens = inputs[i].value.split("_");
                    const newNum = parseInt(tokens[tokens.length - 1]) + (index - i);
                    displayName = inputs[i].value.substring(0, inputs[i].value.length - tokens[tokens.length - 1].length) + newNum.toString();
                    break;
                  }
                }
                // write the inferred name back into the input so it has a real value to
                // swap/reorganize in the grid preview instead of staying blank
                if (displayName) {
                  input.value = displayName;
                }
              }

              const rotation = rotations[index].value;
              if (displayName) {
                const promise = () => fetch(`/api/mapId/name/${displayName}`)
                  .then(response => {
                    if (!response.ok) {
                      throw new Error('Network response was not ok');
                    }
                    return response.json();
                  })
                  .then(data => {
                    idsServer = data.server;
                    idsNsfw = idsNsfw || !!data.nsfw;
                    if (data && data.id && data.imgUrl) {
                      return { id: data.id, imgUrl: `/public/uploads/${data.imgUrl}`, rotation };
                    } else {
                      throw new Error('Invalid data received');
                    }
                  })
                  .catch(error => {
                    console.error('Error fetching data:', error.message);
                    return null;
                  });

                promises.push(promise);
              }
            });

            fetchImagesByBatch(promises)
              .then(results => {
                // Filter out null results
                const validResults = results.filter(result => result !== null);
                if (validResults.length > 0) {
                  resolve(validResults); // Resolve with array of map objects
                } else {
                  reject(new Error('No valid map data fetched'));
                }
              })
              .catch(error => {
                reject(error);
              });
          });
        }

        function fetchImagesByBatch(promises){
          return new Promise((resolve, reject) => {
            if(promises.length <= 1000){
              Promise.all(promises.map(p => p()))
                .then(r => {
                  resolve(r);
                });
            }else{
              Promise.all(promises.slice(0, 1000).map(p => p()))
                .then(r => {
                  // wait until next batch
                  setTimeout(function(){
                    fetchImagesByBatch(promises.slice(1000))
                      .then(r2 => {
                        resolve([...r, ...r2]);
                      });
                  }, 1000);
                });
            }
          });
        }

        fetchButton.addEventListener('click', () => {
          fetchImages()
            .then(mapData => {
              // Ensure mapData is an array
              if (!Array.isArray(mapData)) {
                throw new Error('Map data is not in expected format');
              }

              if (mapData.length === 0) {
                throw new Error('No map data fetched or map IDs found');
              }

              const width = parseInt(widthSelector.value);
              const height = parseInt(heightSelector.value);
              const vertfirst = vertfirstSelector.checked;
              const flipx = flipxSelector.checked;
              const flipy = flipySelector.checked;
              const showGrid = gridPreviewSelector.checked;

              // mutable working copy - swaps in grid mode reorder this in place
              let currentMapData = mapData;

              return joinImages(width, height, currentMapData.map(map => map.imgUrl), currentMapData.map(map => map.rotation), vertfirst, flipx, flipy)
                .then(resultImageUrl => buildResultView({
                  currentMapData, width, height, vertfirst, flipx, flipy, showGrid, resultImageUrl
                }));
            })
            .catch(error => {
              console.error('Error fetching images:', error);
            });
        });

        // swap the map name / rotation values of two input rows above so a later
        // real refetch reproduces whatever arrangement the grid preview ends up with
        function swapInputRows(i, j) {
          const inputs = document.querySelectorAll('#inputContainer input');
          const rotations = document.querySelectorAll('#inputContainer select');
          if (inputs[i] && inputs[j]) {
            const tmpVal = inputs[i].value;
            inputs[i].value = inputs[j].value;
            inputs[j].value = tmpVal;
          }
          if (rotations[i] && rotations[j]) {
            const tmpRot = rotations[i].value;
            rotations[i].value = rotations[j].value;
            rotations[j].value = tmpRot;
          }
        }

        // mirrors the placement math in joinImages.js, in grid cells instead of pixels
        function tilePosition(i, width, height, vertfirst, flipx, flipy) {
          let x, y;
          if (vertfirst) {
            x = Math.floor(i / height);
            y = i % height;
          } else {
            x = i % width;
            y = Math.floor(i / width);
          }
          if (flipx) {
            x = width - 1 - x;
          }
          if (flipy) {
            y = height - 1 - y;
          }
          return { x, y };
        }

        function buildResultView({ currentMapData, width, height, vertfirst, flipx, flipy, showGrid, resultImageUrl }) {
          const outputContainer = document.getElementById('outputContainer');
          outputContainer.innerHTML = ""; // Clear output

          const imageArea = document.createElement('div');
          outputContainer.appendChild(imageArea);

          function setResultUrl(url) {
            return fetch(url)
              .then(response => response.blob())
              .then(resultBlob => {
                blobObj = resultBlob;
              })
              .catch(error => {
                console.error('Error fetching blob:', error);
              });
          }

          function renderSingleImage(url) {
            imageArea.innerHTML = '';
            imageArea.style.display = '';
            const resultImage = document.createElement('img');
            resultImage.src = url;
            imageArea.appendChild(resultImage);
          }

          // tile size in px - adjustable live via the zoom slider, independent of re-renders
          let tileSize = 64;
          let gridEl; // holds just the tiles, kept separate from the zoom controls so they survive re-renders

          function applyGridDims() {
            gridEl.style.display = 'grid';
            gridEl.style.gridTemplateColumns = `repeat(${width}, ${tileSize}px)`;
            gridEl.style.gridTemplateRows = `repeat(${height}, ${tileSize}px)`;
            gridEl.style.gap = '2px';
            gridEl.style.justifyContent = 'center';
            gridEl.style.margin = '10px auto';
          }

          function renderGrid() {
            if (!gridEl) {
              // build the zoom controls and tile container once; later calls only redraw tiles
              imageArea.innerHTML = '';
              imageArea.style.display = '';

              const zoomRow = document.createElement('div');
              zoomRow.classList.add('form-group');
              zoomRow.style.display = 'flex';
              zoomRow.style.alignItems = 'center';
              zoomRow.style.justifyContent = 'center';
              zoomRow.style.gap = '8px';

              const zoomLabel = document.createElement('label');
              zoomLabel.textContent = 'Tile size:';
              zoomLabel.classList.add('mb-0');

              const zoomInput = document.createElement('input');
              zoomInput.type = 'range';
              zoomInput.min = '24';
              zoomInput.max = '160';
              zoomInput.step = '4';
              zoomInput.value = tileSize;
              zoomInput.style.width = '200px';
              zoomInput.addEventListener('input', () => {
                tileSize = parseInt(zoomInput.value);
                applyGridDims();
                gridEl.querySelectorAll('.mapart-tile').forEach(tile => {
                  tile.style.width = `${tileSize}px`;
                  tile.style.height = `${tileSize}px`;
                });
              });

              zoomRow.appendChild(zoomLabel);
              zoomRow.appendChild(zoomInput);
              imageArea.appendChild(zoomRow);

              gridEl = document.createElement('div');
              imageArea.appendChild(gridEl);
            }

            gridEl.innerHTML = '';
            applyGridDims();

            currentMapData.forEach((map, i) => {
              const { x, y } = tilePosition(i, width, height, vertfirst, flipx, flipy);
              const tile = document.createElement('div');
              tile.classList.add('mapart-tile');
              tile.style.gridColumn = x + 1;
              tile.style.gridRow = y + 1;
              tile.style.width = `${tileSize}px`;
              tile.style.height = `${tileSize}px`;
              tile.style.overflow = 'hidden';
              tile.style.border = '1px solid #999';
              tile.style.cursor = 'grab';
              tile.draggable = true;
              tile.title = `map id ${map.id}`;

              const img = document.createElement('img');
              img.src = map.imgUrl;
              img.draggable = false;
              img.style.width = '100%';
              img.style.height = '100%';
              img.style.transform = `rotate(${map.rotation * 90}deg)`;
              tile.appendChild(img);

              tile.addEventListener('dragstart', event => {
                event.dataTransfer.setData('text/plain', String(i));
                tile.style.opacity = '0.5';
              });
              tile.addEventListener('dragend', () => {
                tile.style.opacity = '1';
              });
              tile.addEventListener('dragover', event => {
                event.preventDefault();
              });
              tile.addEventListener('drop', event => {
                event.preventDefault();
                const fromIndex = parseInt(event.dataTransfer.getData('text/plain'));
                const toIndex = i;
                if (!isNaN(fromIndex) && fromIndex !== toIndex) {
                  swapTiles(fromIndex, toIndex);
                }
              });

              gridEl.appendChild(tile);
            });
          }

          // swap two tiles, keep the inputs above in sync, then redo the stitch
          // so publish always uploads the image matching the current arrangement
          function swapTiles(i, j) {
            const tmp = currentMapData[i];
            currentMapData[i] = currentMapData[j];
            currentMapData[j] = tmp;

            swapInputRows(i, j);
            renderGrid();

            addButton.disabled = true;
            joinImages(width, height, currentMapData.map(map => map.imgUrl), currentMapData.map(map => map.rotation), vertfirst, flipx, flipy)
              .then(setResultUrl)
              .then(() => {
                addButton.disabled = false;
              })
              .catch(error => {
                console.error('Error redoing stitch after swap:', error);
                addButton.disabled = false;
              });
          }

          if (showGrid) {
            renderGrid();
          } else {
            renderSingleImage(resultImageUrl);
          }
          setResultUrl(resultImageUrl);

          const formContainer = document.createElement('div');
          formContainer.classList.add('mt-3');

              const nameInputGroup = document.createElement('div');
              nameInputGroup.classList.add('form-group');
              const nameInput = document.createElement('input');
              nameInput.type = 'text';
              nameInput.classList.add('form-control');
              nameInput.placeholder = 'Map Name';
              nameInputGroup.appendChild(nameInput);

              const descriptionInputGroup = document.createElement('div');
              descriptionInputGroup.classList.add('form-group');
              const descriptionInput = document.createElement('input');
              descriptionInput.type = 'text';
              descriptionInput.classList.add('form-control');
              descriptionInput.placeholder = 'Description';
              descriptionInputGroup.appendChild(descriptionInput);

              const artistInputGroup = document.createElement('div');
              artistInputGroup.classList.add('form-group');
              const artistInput = document.createElement('input');
              artistInput.type = 'text';
              artistInput.classList.add('form-control');
              artistInput.placeholder = 'Artist';
              artistInputGroup.appendChild(artistInput);

              const tagsInputGroup = document.createElement('div');
              tagsInputGroup.classList.add('form-group');
              const tagsInput = document.createElement('input');
              tagsInput.type = 'text';
              tagsInput.classList.add('form-control');
              tagsInput.placeholder = 'Tags (comma-seperated)';
              tagsInputGroup.appendChild(tagsInput);

              const nsfwInputGroup = document.createElement('div');
              nsfwInputGroup.classList.add('form-group', 'text-left');
              const nsfwLabel = document.createElement('label');
              nsfwLabel.setAttribute('for', 'nsfwToggle');
              nsfwLabel.classList.add('mr-2');
              nsfwLabel.textContent = 'NSFW: ';
              const nsfwInput = document.createElement('input');
              nsfwInput.type = 'checkbox';
              nsfwInput.id = 'nsfwToggle';
              nsfwInput.checked = idsNsfw;
              nsfwLabel.appendChild(nsfwInput);
              nsfwInputGroup.appendChild(nsfwLabel);

              const fileInput = document.createElement('input');
              fileInput.style.display = 'none';
              fileInput.type = 'file';
              fileInput.name = 'images';
              fileInput.accept = 'image/*';

              fileInput.addEventListener('change', () => {
                const file = fileInput.files[0];
                console.log('Selected file:', file);
              });

              formContainer.appendChild(nameInputGroup);
              formContainer.appendChild(descriptionInputGroup);
              formContainer.appendChild(artistInputGroup);
              formContainer.appendChild(tagsInputGroup);
              formContainer.appendChild(nsfwInputGroup);
              formContainer.appendChild(fileInput);

              const addButton = document.createElement('button');
              addButton.textContent = 'Add to Database';
              addButton.classList.add('btn', 'btn-primary', 'mt-2');
              addButton.addEventListener('click', () => {

                const formData = new FormData();
                formData.append('name', nameInput.value);
                formData.append('description', descriptionInput.value);
                formData.append('artist', artistInput.value);
                formData.append('server', idsServer);
                formData.append('nsfw', nsfwInput.checked);
                formData.append('file', blobObj);
                formData.append('mapIds', JSON.stringify(currentMapData.map(map => map.id)));
                formData.append('width', width);
                formData.append('height', height);
                // Convert comma-separated values into a JSON array
                const tagsArray = tagsInput.value.split(',').map(tag => tag.trim());
                formData.append('tags', JSON.stringify(tagsArray));

                console.log(formData);

                return fetch('/mapart/create', {
                  method: 'POST',
                  body: formData,
                })
                .then(response => {
                  if (!response.ok) {
                    throw new Error('Failed to add image to database');
                  }
                  return response.json();
                })
                .then(data => {
                    console.log('Image added to database:', data);
                    const successDiv = document.createElement('div');
                    successDiv.classList.add('alert', 'alert-success');
                    successDiv.style.paddingTop = '10px';
                    
                    const successText = document.createElement('span');
                    successText.textContent = 'Image added to database successfully. Click ';

                    const link = document.createElement('a');
                    link.textContent = 'here';
                    link.href = '/mapart/id/' + data.id;

                    successText.appendChild(link);
                    successText.appendChild(document.createTextNode(' to view.'));

                    successDiv.appendChild(successText);
                    document.getElementById('outputContainer').appendChild(successDiv);

                    document.getElementById('inputContainer').style.display = 'none';
                    document.querySelectorAll('button').forEach(button => {
                        button.style.display = 'none';
                    });
                    document.querySelectorAll('.form-group').forEach(select => {
                        select.style.display = 'none';
                    });
                })
                .catch(error => {
                  console.error('Error adding image to database:', error);
                  const errorDiv = document.createElement('div');
                  errorDiv.classList.add('alert', 'alert-danger');
                  errorDiv.textContent = `Error adding image to database: ${error.message}`;
                  errorDiv.style.paddingTop = '10px';
                  document.getElementById('outputContainer').appendChild(errorDiv);
                  document.getElementById('inputContainer').style.display = 'none';
                  document.querySelectorAll('button').forEach(button => {
                    button.style.display = 'none';
                  });
                  document.querySelectorAll('.form-group').forEach(select => {
                    select.style.display = 'none';
                  });
                });
              });

              formContainer.appendChild(addButton);
              outputContainer.appendChild(formContainer);
        }

        generateInputs();

      include includes/scripts.pug
