doctype html
html
  include includes/head.pug
  body
    include includes/navbar.pug

    .container
      h1.text-center Maps Missing Information
      hr
      if !admin && !mod
        div.alert.alert-danger(role="alert")
          | You are not an administrator or a moderator
      else
        form(method='get', action='/mapart/missingInfo')
          .form-group.text-center
            label.sr-only(for='missingType') Filter by missing info type:
            .input-group.mb-2.mr-sm-2
              .input-group-prepend
                .input-group-text Type
              select#missingType.form-control(name='type')
                option(value='allbutdesc') All but description
                option(value='all') All
                option(value='name') Name
                option(value='artist') Artist
                option(value='description') Description
                option(value='tags') Tags
              .input-group-append
                button.btn.btn-primary(type='submit') Filter

          script.
            document.addEventListener('DOMContentLoaded', function () {
              // Function to get query parameters by name
              function getQueryParam(name) {
                name = name.replace(/[\[\]]/g, '\\$&');
                var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
                    results = regex.exec(window.location.href);
                if (!results) return null;
                if (!results[2]) return '';
                return decodeURIComponent(results[2].replace(/\+/g, ' '));
              }

              // Get the 'type' query parameter
              var type = getQueryParam('type');

              // Set the select element's value
              if (type) {
                var selectElement = document.getElementById('missingType');
                selectElement.value = type;
              }
            });

        h2#countDisplay.text-center Count: ...

        #emptyState.alert.alert-warning(style="display: none;") Maps with complete info or no records found.

        .row#gridContainer.mb-4

        #loadingSpinner.text-center.mt-4
          i.fa.fa-spinner.fa-spin.fa-3x
          p Loading...

        script.
          const missingType = "#{type}";
          const perPage = 24;
          let currentPage = 0;
          let loading = false;
          let exhausted = false;
          let observer;

          function buildCard(map) {
            const col = document.createElement('div');
            col.className = 'col-md-4';
            col.innerHTML = `
              <div class="card mb-4 box-shadow">
                <img class="card-img-top pixelated-image" src="/public/uploads/mapart/${map.imgUrl}" alt="Image for ${map.name || 'Unnamed Map'}">
                <div class="card-body">
                  <h5 class="card-title">${map.name || 'No Name'}</h5>
                  <p class="card-text">Artist: ${map.artist || 'N/A'}</p>
                  <p class="card-text">Description: ${map.description || 'N/A'}</p>
                  <p class="card-text">Tags: ${map.tags && map.tags.length ? map.tags.join(', ') : 'No Tags'}</p>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <a class="btn btn-sm btn-outline-secondary" href="/mapart/id/${map.id}">View</a>
                      <a class="btn btn-sm btn-outline-secondary" href="/mapart/edit/${map.id}">Edit</a>
                    </div>
                    <small class="text-muted">${new Date(map.createdAt).toLocaleDateString()}</small>
                  </div>
                </div>
              </div>
            `;
            return col;
          }

          function startObservingIntersection() {
            if (observer) observer.disconnect();
            const gridContainer = document.getElementById('gridContainer');
            const lastElement = gridContainer.lastElementChild;
            if (!lastElement) return;

            observer = new IntersectionObserver(entries => {
              if (entries[0].isIntersecting) {
                fetchNextPage();
              }
            }, {
              root: null,
              rootMargin: '200px',
              threshold: 0.0
            });
            observer.observe(lastElement);
          }

          async function fetchNextPage() {
            if (loading || exhausted) return;
            loading = true;
            currentPage++;

            const loadingSpinner = document.getElementById('loadingSpinner');
            loadingSpinner.style.display = 'block';

            try {
              const url = `/api/mapArt/missingInfo?type=${encodeURIComponent(missingType)}&page=${currentPage}&perPage=${perPage}`;
              const response = await fetch(url);

              if (!response.ok) {
                throw new Error('Network response was not ok');
              }

              const maps = await response.json();

              if (maps.length === 0) {
                exhausted = true;
                if (currentPage === 1) {
                  document.getElementById('emptyState').style.display = 'block';
                }
                return;
              }

              const gridContainer = document.getElementById('gridContainer');
              maps.forEach(map => gridContainer.appendChild(buildCard(map)));

              if (maps.length < perPage) {
                exhausted = true;
              } else {
                startObservingIntersection();
              }
            } catch (error) {
              console.error('Error fetching maps missing info:', error);
              exhausted = true;
            } finally {
              loading = false;
              loadingSpinner.style.display = 'none';
            }
          }

          async function fetchCount() {
            const countDisplay = document.getElementById('countDisplay');
            try {
              const url = `/api/mapArt/missingInfoCount?type=${encodeURIComponent(missingType)}`;
              const response = await fetch(url);
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }
              const count = await response.json();
              countDisplay.textContent = `Count: ${count}`;
            } catch (error) {
              console.error('Error fetching missing info count:', error);
              countDisplay.textContent = 'Count: unknown';
            }
          }

          fetchNextPage();
          fetchCount();

    style.
      .pixelated-image {
        image-rendering: pixelated;
      };

    include includes/scripts.pug
