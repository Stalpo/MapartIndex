doctype html
html
  - const pageTitle = "MapArt Edit"
  include includes/head.pug
  body
    include includes/navbar.pug

    div.container
      h1.text-center= pageTitle
      hr
      if !admin && !mod
        div.alert.alert-danger(role="alert")
          | You are not an administrator or a moderator
      else
        div.row
          div.col-md-8.offset-md-2.text-center
            form#editForm.text-center
              div.mb-3.form-group(data-toggle='tooltip', title='Name')
                div.input-group
                  div.input-group-prepend
                    span.input-group-text.icon-prepend
                      i.fas.fa-file
                  input#name.form-control(type='text', name='name', value=map.name, placeholder='Name')

              div.mb-3.form-group(data-toggle='tooltip', title='Description')
                div.input-group
                  div.input-group-prepend
                    span.input-group-text.icon-prepend
                      i.fas.fa-font
                  input#description.form-control(type='text', name='description', value=map.description, placeholder='Description')

              div.mb-3.form-group(data-toggle='tooltip', title='Artist')
                div.input-group
                  div.input-group-prepend
                    span.input-group-text.icon-prepend
                      i.fas.fa-paint-brush
                  input#artist.form-control(type='text', name='artist', value=map.artist, placeholder='Artist')

              div.mb-3.form-group(data-toggle='tooltip', title='Tags (comma-separated)')
                div.input-group
                  div.input-group-prepend
                    span.input-group-text.icon-prepend
                      i.fas.fa-list
                  input#tags.form-control(type='text', name='tags', value=map.tags, placeholder='Tags (comma-separated)')

              div.mb-3.form-group(data-toggle='tooltip', title='Uploader')
                div.input-group
                  div.input-group-prepend
                    span.input-group-text.icon-prepend
                      i.fas.fa-upload
                  input#user.form-control(type='text', name='user', value=map.username, readonly, placeholder='Uploader')

              div.mb-3.form-group(data-toggle='tooltip', title='NSFW')
                div.input-group
                  label.fancy-checkbox
                    input#nsfw.form-check-input(type='checkbox', name='nsfw', checked=map.nsfw)
                    i.fas.fa-fw.fa-check-square.checked
                    i.fas.fa-fw.fa-square.unchecked
                    | NSFW

              // Submit button
              button#saveBtn.btn.btn-primary(type='button') Save Changes
              if admin || (mod && map.userId === userId)
                button#deleteBtn.btn.btn-primary(type='button') Delete

            .alert.alert-success#successMessage(style='text-align: center; display: none; margin-top: 10px;')
            .alert.alert-danger#errorMessage(style='text-align: center; display: none; margin-top: 10px;')

        div.row.mt-4
          div.col-md-8.offset-md-2
            h3.text-center Duplicate Check
            .form-group.text-center
              label.fancy-checkbox
                input#dupGlobal.form-check-input(type='checkbox')
                i.fas.fa-fw.fa-check-square.checked
                i.fas.fa-fw.fa-square.unchecked
                |  Check all servers (default: this server only)
            .text-center.mb-3
              button#dupCheckMapArts.btn.btn-outline-primary.m-1(type='button') Check vs MapArts
              button#dupCheckChunks.btn.btn-outline-primary.m-1(type='button') Check vs MapId Chunks
              button#dupCheckAll.btn.btn-primary.m-1(type='button') Check All

            #dupLoadingSpinner.text-center.mt-3(style='display: none;')
              i.fa.fa-spinner.fa-spin.fa-2x
              p Checking...

            #dupBackfillNotice.alert.alert-info(style='display: none;')
              | This record hasn't been hashed for duplicate checking yet. Run the backfill script (scripts/backfillDuplicateHashes.js) to enable this.

            #dupEmptyState.alert.alert-warning(style='display: none;') No duplicates found.

            .row#dupResults.mb-4

      style.
        .icon-prepend {
          width: 40px;
          text-align: center;
        }
        .mb-3 {
          margin-bottom: 1rem;
        }

        .fancy-checkbox input[type="checkbox"],
        .fancy-checkbox .checked {
          display: none;
        }

        .fancy-checkbox input[type="checkbox"]:checked ~ .checked {
          display: inline-block;
        }

        .fancy-checkbox input[type="checkbox"]:checked ~ .unchecked {
          display: none;
        }

    script(src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js")
    script.
      $(document).ready(function(){
        $('[data-toggle="tooltip"]').tooltip();
      });


      document.addEventListener("DOMContentLoaded", function() {
          // Load tags into the tags input field
          var tagsInput = document.getElementById('tags');
          if (tagsInput.value) {
              var tagsArray = JSON.parse(tagsInput.value);
              tagsInput.value = tagsArray.join(', ');
          }
      });

      function saveChanges() {
          var artist = document.getElementById('artist').value;
          var nsfw = document.getElementById('nsfw').checked;
          var user = document.getElementById('user').value;
          var name = document.getElementById('name').value;
          var description = document.getElementById('description').value;

          // Parse comma-separated tags into an array
          var tagsInput = document.getElementById('tags').value;
          var tagsArray = tagsInput.split(',').map(tag => tag.trim());

          var formData = new FormData();
          formData.append('name', name);
          formData.append('artist', artist);
          formData.append('description', description);
          formData.append('nsfw', nsfw);

          // Append tags as JSON array to FormData
          formData.append('tags', JSON.stringify(tagsArray));

          // Get mapId from the current URL
          var url = window.location.href;
          var mapId = url.substring(url.lastIndexOf('/') + 1);

          var xhr = new XMLHttpRequest();
          xhr.open('POST', `/mapart/edit/${mapId}`, true);
          xhr.onreadystatechange = function () {
              if (xhr.readyState === XMLHttpRequest.DONE) {
                  if (xhr.status === 200) {
                      // Show success message
                      var successMessage = document.getElementById('successMessage');
                      successMessage.style.display = 'block';
                      successMessage.innerText = 'Changes saved successfully';

                      // Hide error message if it's shown
                      var errorMessage = document.getElementById('errorMessage');
                      errorMessage.style.display = 'none';
                  } else {
                      // Show error message
                      var errorMessage = document.getElementById('errorMessage');
                      errorMessage.style.display = 'block';
                      errorMessage.innerText = 'Failed to save changes. Please try again.';

                      // Hide success message if it's shown
                      var successMessage = document.getElementById('successMessage');
                      successMessage.style.display = 'none';
                  }
              }
          };
          xhr.send(formData);
      }

      function deleteMapart(){
          var url = window.location.href;
          var mapId = url.substring(url.lastIndexOf('/') + 1);

          var xhr = new XMLHttpRequest();
          xhr.open('POST', `/mapart/delete?mapId=${mapId}`, true);
          xhr.onreadystatechange = function () {
              if (xhr.readyState === XMLHttpRequest.DONE) {
                  if (xhr.status === 200) {
                      // Send back to gallary
                      window.location.href = "/mapart/gallery/";
                  } else {
                      // Show error message
                      var errorMessage = document.getElementById('errorMessage');
                      errorMessage.style.display = 'block';
                      errorMessage.innerText = 'Failed to delete. Please try again.';

                      // Hide success message if it's shown
                      var successMessage = document.getElementById('successMessage');
                      successMessage.style.display = 'none';
                  }
              }
          };
          xhr.send();
      }

      document.getElementById('saveBtn').addEventListener('click', saveChanges);
      document.getElementById('deleteBtn').addEventListener('click', deleteMapart);

      function currentMapArtId() {
        var url = window.location.href;
        return url.substring(url.lastIndexOf('/') + 1);
      }

      function buildDupCard(match) {
        var record = match.record;
        var isMapId = match.type === 'mapid' || match.type === 'mapid-chunk';
        var imgSrc = isMapId ? `/public/uploads/${record.imgUrl}` : `/public/uploads/mapart/${record.imgUrl}`;
        var title = record.name || record.displayName || 'No Name';
        var viewHref = isMapId ? `/mapid/id/${record.id}` : `/mapart/id/${record.id}`;
        var editHref = isMapId ? `/mapid/edit/${record.id}` : `/mapart/edit/${record.id}`;
        var typeLabel = {
          mapart: 'Duplicate MapArt',
          'mapid-chunk': 'MapId found matching a chunk of this MapArt'
        }[match.type] || match.type;
        var positionLabel = match.position ? ` @ (${match.position.x}, ${match.position.y})` : '';

        var col = document.createElement('div');
        col.className = 'col-md-4';
        col.innerHTML = `
          <div class="card mb-4 box-shadow">
            <img class="card-img-top pixelated-image" src="${imgSrc}" alt="Image for ${title}">
            <div class="card-body">
              <h5 class="card-title">${title}</h5>
              <p class="card-text">${typeLabel}${positionLabel}</p>
              <p class="card-text">Server: ${record.server || 'N/A'}</p>
              <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary" href="${viewHref}">View</a>
                <a class="btn btn-sm btn-outline-secondary" href="${editHref}">Edit</a>
              </div>
            </div>
          </div>
        `;
        return col;
      }

      async function runDupCheck(mode) {
        var mapArtId = currentMapArtId();
        var global = document.getElementById('dupGlobal').checked;

        var spinner = document.getElementById('dupLoadingSpinner');
        var backfillNotice = document.getElementById('dupBackfillNotice');
        var emptyState = document.getElementById('dupEmptyState');
        var results = document.getElementById('dupResults');

        spinner.style.display = 'block';
        backfillNotice.style.display = 'none';
        emptyState.style.display = 'none';
        results.innerHTML = '';

        try {
          var url = `/api/mapArt/duplicates/${mapArtId}?mode=${mode}&global=${global}`;
          var response = await fetch(url);
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          var data = await response.json();

          if (data.needsBackfill) {
            backfillNotice.style.display = 'block';
          } else if (!data.matches || data.matches.length === 0) {
            emptyState.style.display = 'block';
          } else {
            data.matches.forEach(match => results.appendChild(buildDupCard(match)));
          }
        } catch (error) {
          console.error('Error running duplicate check:', error);
          emptyState.textContent = 'Error running duplicate check. Please try again.';
          emptyState.style.display = 'block';
        } finally {
          spinner.style.display = 'none';
        }
      }

      document.getElementById('dupCheckMapArts').addEventListener('click', () => runDupCheck('maparts'));
      document.getElementById('dupCheckChunks').addEventListener('click', () => runDupCheck('chunks'));
      document.getElementById('dupCheckAll').addEventListener('click', () => runDupCheck('all'));

    style.
      .pixelated-image {
        image-rendering: pixelated;
      }

    include includes/scripts.pug
