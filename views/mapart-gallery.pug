doctype html
html
  - const pageTitle = "Map Arts"
  include includes/head.pug
  body
    include includes/navbar.pug
    div.container
      if !server
        h1.text-center #{pageTitle}
      else 
        h1.text-center #{displayName} #{pageTitle}
      hr
      div.row.justify-content-center
        div.col-auto
          button#toggleSelectorsButton.btn.btn-primary.btn-sm.mb-3 Filtering and Sorting
      form#selectorsForm(style={display: 'none'})
        div.row.justify-content-center
          div.row
            div.col
              select#userSelector.form-control(data-live-search='true')
          div.row
            div.col
              select#artistSelector.form-control(data-live-search='true')
          div.row(style=`${!server ? '' : 'display:none'}`)
            div.col
              select#serverSelector.form-control(data-live-search='true')
          div.row
            div.col
              select#tagSelector.form-control(data-live-search='true')
          div.row
            div.col
              select#sortSelector.form-control
          if username
            div.row
              div.col
                select#collectedSelector.form-control
          div.row
            div.col
              select#viewSelector.form-control
                option(value='smallGrid' selected='true') Thumbnails
                option(value='grid') Cards
                option(value='table') Table
                option(value='compactTable') Compact Table
                option(value='carousel') Carousel
          div.row#carouselSpeedRow(style='display:none')
            div.col
              select#carouselSpeedSelector.form-control
                option(value='2000') Carousel Speed: Fast (2s)
                option(value='3500' selected='true') Carousel Speed: Normal (3.5s)
                option(value='6000') Carousel Speed: Slow (6s)
                option(value='10000') Carousel Speed: Very Slow (10s)
                option(value='manual') Carousel Speed: Manual (Arrows Only)
      hr

      div.row.justify-content-center
        div.col-auto
          h2#countDisplay.text-center Count: 0
      hr

      script.
        // Function to fetch data from the API
        async function fetchData(url) {
          const response = await fetch(url);
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        }

        // Function to populate a select element and optionally set a default selection
        function populateSelect(selectId, options, defaultOption = "") {
          const select = document.getElementById(selectId);
          select.innerHTML = "";

          options.forEach(option => {
            const optElement = document.createElement("option");
            optElement.value = option;
            optElement.textContent = option;
            if (option === defaultOption) {
              optElement.selected = true;
            }
            select.appendChild(optElement);
          });

          $(`#${selectId}`).selectpicker('refresh');
        }

        // Function to populate user selector
        async function populateUserSelector() {
          try {
            const uniqueUsernames = await fetchData('/mapart/uniqueUsernames');
            uniqueUsernames.unshift("All Uploaders");
            uniqueUsernames.sort();
            populateSelect('userSelector', uniqueUsernames, "All Uploaders");
          } catch (error) {
            console.error('Error fetching user data:', error);
          }
        }

        // Function to populate artist selector
        async function populateArtistSelector() {
          try {
            const artistArray = await fetchData('/mapart/uniqueArtists');
            
            let uniqueArtists = artistArray.reduce((acc, artistString) => {
              return acc.concat(artistString.split(',').map(artist => artist.trim()).filter(artist => artist !== ''));
            }, []);

            // Remove duplicates and sort, ensuring "All Artists" is first in the list
            uniqueArtists = [...new Set(uniqueArtists)];
            uniqueArtists.unshift("All Artists");
            uniqueArtists.sort((a, b) => (a === "All Artists" ? -1 : b === "All Artists" ? 1 : a.localeCompare(b)));

            populateSelect('artistSelector', uniqueArtists, "All Artists");
          } catch (error) {
            console.error('Error fetching artist data:', error);
          }
        }

        // Function to populate server selector
        async function populateServerSelector() {
          try {
            const uniqueServers = await fetchData('/mapart/uniqueServers');
            uniqueServers.sort();
            uniqueServers.unshift("All Servers");
            let server = "#{server}";
            if(!server){
              populateSelect('serverSelector', uniqueServers, "All Servers");
            }else{
              populateSelect('serverSelector', uniqueServers, server);
            }
          } catch (error) {
            console.error('Error fetching server data:', error);
          }
        }

        // Function to populate tag selector
        async function populateTagSelector() {
          try {
            const uniqueTags = await fetchData('/mapart/uniqueTags');
            uniqueTags.unshift("All Tags");
            uniqueTags.sort();
            populateSelect('tagSelector', uniqueTags, "All Tags");
          } catch (error) {
            console.error('Error fetching tag data:', error);
          }
        }

        async function populateSortSelector() {
          const sortSelector = document.getElementById('sortSelector');

          const options = [
            { value: 'nameAsc', label: 'Name (Ascending)' },
            { value: 'nameDesc', label: 'Name (Descending)' },
            { value: 'artistAsc', label: 'Artist (Ascending)' },
            { value: 'artistDesc', label: 'Artist (Descending)' },
            { value: 'dateAsc', label: 'Date (Ascending)' },
            { value: 'dateDesc', label: 'Date (Descending)', selected: true },
            { value: 'sizeAsc', label: 'Size (Ascending)'},
            { value: 'sizeDesc', label: 'Size (Descending)'},
            { value: 'viewsAsc', label: 'Views (Ascending)'},
            { value: 'viewsDesc', label: 'Views (Descending)'},
            { value: 'likesAsc', label: 'Likes (Ascending)'},
            { value: 'likesDesc', label: 'Likes (Descending)'},
            { value: 'random', label: 'Random' },
          ];

          options.forEach(option => {
            const sortOption = document.createElement('option');
            sortOption.value = option.value;
            sortOption.textContent = option.label;
            if (option.selected) {
              sortOption.setAttribute('selected', true);
            }
            sortSelector.appendChild(sortOption);
          });
          $(sortSelector).selectpicker('refresh');
        }

        async function populateCollectedSelector() {
          collectedSelector = document.getElementById('collectedSelector');
          if(collectedSelector === null) return;

          const collectedOptionNone = document.createElement('option');
          collectedOptionNone.value = undefined;
          collectedOptionNone.textContent = 'Ignore Collected Status';
          collectedOptionNone.setAttribute('selected', true);
          collectedSelector.appendChild(collectedOptionNone);

          const collectedOptionCollected = document.createElement('option');
          collectedOptionCollected.value = "collected";
          collectedOptionCollected.textContent = 'Collected';
          collectedSelector.appendChild(collectedOptionCollected);

          const collectedOptionNotCollected = document.createElement('option');
          collectedOptionNotCollected.value = 'notcollected';
          collectedOptionNotCollected.textContent = 'Not Collected';
          collectedSelector.appendChild(collectedOptionNotCollected);

          $(collectedSelector).selectpicker('refresh');
        }

        // Function to handle API call with updated parameters
        async function fetchMaps(page = 1, user = "", artist = "", sort = "dateDesc", view, server, tag, collected, seed) {
          const perPage = 25;
          let url = `/api/mapArt/maps?page=${page}&perPage=${perPage}&sort=${sort}`;
          if (sort === 'random' && seed) {
            url += `&seed=${seed}`;
          }
          // Construct URL based on selected values
          if (user && user !== "All Uploaders") {
            url += `&user=${user}`;
          }
          if (artist && artist !== "All Artists") {
            url += `&artist=${artist}`;
          }
          if ("#{server}") {
            url += `&server=#{server}`;
          } else if (server && server !== "All Servers") {
            url += `&server=${server}`;
          }
          if (tag && tag !== "All Tags") {
            url += `&tag=${tag}`;
          }
          if (collected) {
            url += `&collected=${collected}`;
          }

          // Show loading spinner
          document.getElementById('loadingSpinner').style.display = 'block';

          try {
            const response = await fetch(url);
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            const data = await response.json();

            // An empty page means there's nothing more to load.
            if (data.length === 0) {
              hasMorePages = false;
              return;
            }

            // Based on the selected view type
            // Update the grid from response
            switch (view) {
              case 'smallGrid':
                buildSmallGrid(data);
                break;
              case 'grid':
                buildGrid(data);
                break;
              case 'table':
                buildTable(data, false);
                break;
              case 'compactTable':
                buildTable(data, true);
                break;
              case 'carousel':
                buildCarousel(data);
                break;
              default:
                buildSmallGrid(data);
                break;
            }

            // Start observing intersection once grid is populated
            startObservingIntersection();
          } catch (error) {
            console.error('Error fetching map data:', error);
          } finally {
            // Hide loading spinner regardless of success or failure
            document.getElementById('loadingSpinner').style.display = 'none';
          }
        }

        async function fetchMapsCount(user = "", artist = "", server, tag, collected) {
          let url = `/api/mapArt/mapscount?thing=1`;
          // Construct URL based on selected values
          if (user && user !== "All Uploaders") {
            url += `&user=${user}`;
          }
          if (artist && artist !== "All Artists") {
            url += `&artist=${artist}`;
          }
          if ("#{server}") {
            url += `&server=#{server}`;
          } else if (server && server !== "All Servers") {
            url += `&server=${server}`;
          }
          if (tag && tag !== "All Tags") {
            url += `&tag=${tag}`;
          }
          if (collected) {
            url += `&collected=${collected}`;
          }

          try {
            const response = await fetch(url);
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            const data = await response.json();
            document.getElementById('countDisplay').textContent = `Count: ${data}`;
            totalCount = data;
            updateCarouselPositionDisplay();
          } catch (error) {
            console.error('Error fetching map count data:', error);
          }
        } 

        // Function to handle selector and view selector change events
        function handleSelectorsChange() {
          currentPage = 1; // Reset currentPage to 1
          hasMorePages = true;
          const user = document.getElementById('userSelector').value;
          const artist = document.getElementById('artistSelector').value;
          const sort = document.getElementById('sortSelector').value;
          const view = document.getElementById('viewSelector').value;
          const server = document.getElementById('serverSelector').value;
          const tag = document.getElementById('tagSelector').value;

          collectedSelector = document.getElementById('collectedSelector');
          collected = (collectedSelector !== null) ? collectedSelector.value : undefined;

          if (sort === 'random') {
            randomSeed = generateRandomSeed();
          }

          // Clear the grid before fetching new data
          clearGrid();
          clearTable(view);
          clearCarousel(view);

          // Pass selected view type to fetchMaps
          fetchMaps(1, user, artist, sort, view, server, tag, collected, randomSeed);
          fetchMapsCount(user, artist, server, tag, collected);
        }

        // Function to clear the grid
        function clearGrid() {
          const gridContainer = document.getElementById('gridContainer');
          gridContainer.innerHTML = '';
        }

        // Function to clear the table
        function clearTable(view) {
          const tableContainerBody = document.getElementById('tableContainerBody');
          tableContainerBody.innerHTML = '';

          const imageColumn = document.querySelector('#tableContainer th:nth-child(4)');
          imageColumn.style.display = view === 'compactTable' ? 'none' : 'block';

          const tableContainer = document.getElementById('tableContainer');
          tableContainer.style.display = (view === 'table' || view === 'compactTable') ? 'table' : 'none';
        }

        // Function to clear the carousel
        function clearCarousel(view) {
          const carouselInner = document.querySelector('#carouselContainer .carousel-inner');
          carouselInner.innerHTML = '';
          nextSlidePosition = 1;
          updateCarouselPositionDisplay();

          document.getElementById('carouselContainer').style.display = view === 'carousel' ? 'block' : 'none';
          document.getElementById('carouselSpeedRow').style.display = view === 'carousel' ? 'block' : 'none';

          // Only restart the cycle timer when carousel mode is actually being switched on
          // (not on every unrelated filter change while already viewing the carousel), so
          // the countdown to the next auto-advance stays predictable while browsing.
          if (view === 'carousel' && !carouselActive) {
            initCarousel(getCarouselInterval());
          }
          carouselActive = view === 'carousel';
        }

        // Attach event listeners to input selectors
        document.getElementById('userSelector').addEventListener('change', handleSelectorsChange);
        document.getElementById('artistSelector').addEventListener('change', handleSelectorsChange);
        document.getElementById('sortSelector').addEventListener('change', handleSelectorsChange);
        document.getElementById('viewSelector').addEventListener('change', handleSelectorsChange);
        document.getElementById('serverSelector').addEventListener('change', handleSelectorsChange);
        document.getElementById('tagSelector').addEventListener('change', handleSelectorsChange);

        collectedSelector = document.getElementById('collectedSelector');
        if(collectedSelector) collectedSelector.addEventListener('change', handleSelectorsChange);

        // Function to build the grid
        function buildSmallGrid(maps) {
          const gridContainer = document.getElementById('gridContainer');

          // Check if showNSFW cookie is true
          const showNSFW = getCookie('showNSFW');

          // Build grid
          maps.forEach(map => {
            const card = document.createElement('div');
            card.className = 'mb-3 mx-auto';
            card.innerHTML = `
              <div class="card mb-3 mx-auto ${showNSFW === 'true' ? '' : (map.nsfw ? 'nsfw' : '')}">
                <div class="image-wrapper">
                  <a href="/mapart/id/${map.id}" class="image-link">
                    <img src="/public/uploads/mapart/${map.imgUrl}" class="${map.width > 8 ? '' : 'pixelated-image'} ${showNSFW === 'true' ? '' : (map.nsfw ? 'blurred' : '')}" alt="Map Image">
                  </a>
                </div>
              </div>
            `;
            // only show nsfw if user is logged in
            if(getCookie('token') !== '' || !map.nsfw){
              gridContainer.appendChild(card);
            }
          });
        };

        // Function to build the grid
        function buildGrid(maps) {
          const gridContainer = document.getElementById('gridContainer');

          // Check if showNSFW cookie is true
          const showNSFW = getCookie('showNSFW');

          // Build grid
          maps.forEach(map => {
            const card = document.createElement('div');
            card.className = 'mb-3 mx-auto';
            card.style = 'width: 18rem;';
            card.innerHTML = `
              <div class="card mb-3 mx-auto ${showNSFW === 'true' ? '' : (map.nsfw ? 'nsfw' : '')}">
                <div class="image-wrapper">
                  <img src="/public/uploads/mapart/${map.imgUrl}" class="${map.width > 2 ? '' : 'pixelated-image'} ${showNSFW === 'true' ? '' : (map.nsfw ? 'blurred' : '')}" alt="Map Image">
                </div>
                <div class="card-body">
                  <h5 class="card-title">${map.name ? map.name : map.displayName}</h5>
                </div>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item">Server: ${map.server}</li>
                  <li class="list-group-item">Artist: <a href="/search?query=${map.artist}">${map.artist}</a></li>
                  ${map.tags[0] !== "" ? `<li class="list-group-item">Tags: ${map.tags.map(tag => `<a href="/search?query=${tag}"><span class="badge badge-secondary">${tag}</span></a>`).join(' ')}</li>` : ''}
                  <li class="list-group-item">Size: ${map.size} (${map.width} x ${map.height}) </li>
                </ul>
                <div class="card-body">
                  <a href="/mapart/id/${map.id}" class="card-link">View Map</a>
                </div>
              </div>
            `;
            // only show nsfw if user is logged in
            if(getCookie('token') !== '' || !map.nsfw){
              gridContainer.appendChild(card);
            }
          });
        }

        // Function to build the table
        function buildTable(maps, compact) {
          const tableContainerBody = document.getElementById('tableContainerBody');
          let mapnumber = tableContainerBody.childElementCount;

          // Check if showNSFW cookie is true
          const showNSFW = getCookie('showNSFW');

          // Build table
          maps.forEach(map => {
            mapnumber++;
            const newRow = document.createElement('tr');
            newRow.className = 'vertical-center';
            newRow.innerHTML = `
              <td>${mapnumber}</td>
              <td><a href="/mapart/id/${map.id}" style="display: inline-block; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${map.name ? map.name : map.displayName}</a></td>
              <td>${map.server}</td>
              ${compact ? "" : `<td><img src="/public/uploads/mapart/${map.imgUrl}" alt="Map Image" style="max-width: 100px; max-height: 100px;" class="${showNSFW === 'true' ? '' : (map.nsfw ? 'smallblurred' : '')}"></td>`}
              <td><a href="/search?query=${map.artist}" style="display: inline-block; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${map.artist}</a></td>
              <td>${map.size} (${map.width} x ${map.height})</td>
              <td style="max-width: 150px;">${map.tags.map(tag => `<a href="/search?query=${tag}"><span class="badge badge-secondary">${tag}</span></a>`).join(' ')}</td>
              <td>${map.views}</td>
              <td>${map.likes}</td>
            `;
            // only show nsfw if user is logged in
            if(getCookie('token') !== '' || !map.nsfw){
              tableContainerBody.appendChild(newRow);
            }
          });
        }

        // Function to build the carousel
        function buildCarousel(maps) {
          const carouselInner = document.querySelector('#carouselContainer .carousel-inner');

          // Check if showNSFW cookie is true
          const showNSFW = getCookie('showNSFW');

          let assignedActive = !!carouselInner.querySelector('.carousel-item.active');

          maps.forEach(map => {
            // only show nsfw if user is logged in
            if (!(getCookie('token') !== '' || !map.nsfw)) return;

            const item = document.createElement('div');
            item.className = assignedActive ? 'carousel-item' : 'carousel-item active';
            assignedActive = true;
            item.dataset.position = nextSlidePosition++;
            item.innerHTML = `
              <img src="/public/uploads/mapart/${map.imgUrl}" class="d-block w-100 ${map.width > 2 ? '' : 'pixelated-image'} ${showNSFW === 'true' ? '' : (map.nsfw ? 'blurred' : '')}" alt="Map Image">
            `;
            carouselInner.appendChild(item);
          });

          pruneCarousel();
          updateCarouselPositionDisplay();
        }

        // Function to bound the number of carousel slides kept in the DOM
        function pruneCarousel() {
          const carouselInner = document.querySelector('#carouselContainer .carousel-inner');
          const items = Array.from(carouselInner.children);
          const activeIndex = items.findIndex(item => item.classList.contains('active'));
          const keepBehind = 3;
          if (activeIndex > keepBehind) {
            items.slice(0, activeIndex - keepBehind).forEach(item => item.remove());
          }
        }

        // Function to get cookie value by name
        function getCookie(name) {
          const cookies = document.cookie.split(';');
          for (let cookie of cookies) {
            const [cookieName, cookieValue] = cookie.split('=');
            if (cookieName.trim() === name) {
              return cookieValue;
            }
          }
          return '';
        }

        // Lazy loading
        let observer;
        let currentPage = 1;
        let hasMorePages = true;
        let user = "";
        let artist = "";
        let server = "";
        let tag = "";
        let sort = "dateDesc";
        let randomSeed = null;
        let carouselFetchInFlight = false;
        let carouselActive = false;
        let totalCount = 0;
        let nextSlidePosition = 1;

        function generateRandomSeed() {
          return Math.random().toString(36).slice(2);
        }

        // 'manual' disables autoplay (interval: false) so only the prev/next arrows move the carousel
        function getCarouselInterval() {
          const raw = document.getElementById('carouselSpeedSelector').value;
          return raw === 'manual' ? false : parseInt(raw);
        }

        // Each slide gets a permanent sequence number when it's created (data-position), so the
        // "current / total" display stays correct when navigating backward and wraps cleanly
        // (via modulo) once the carousel loops back around past the end of the dataset.
        function updateCarouselPositionDisplay() {
          const display = document.getElementById('carouselPositionDisplay');
          const activeItem = document.querySelector('#carouselContainer .carousel-item.active');
          if (!display) return;
          if (!activeItem || !totalCount) {
            display.textContent = '';
            return;
          }
          const rawPosition = parseInt(activeItem.dataset.position, 10);
          const wrappedPosition = ((rawPosition - 1) % totalCount) + 1;
          display.textContent = `${wrappedPosition} / ${totalCount}`;
        }

        function startObservingIntersection() {
          observer = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) {
              fetchNextPage();
            }
          }, {
            root: null,
            rootMargin: '0px',
            threshold: 0.0
          });

          const lastGridElement = document.getElementById('gridContainer').lastElementChild;
          const lastTableElement = document.getElementById('tableContainerBody').lastElementChild;
          if (lastGridElement) observer.observe(lastGridElement);
          else if (lastTableElement) observer.observe(lastTableElement);
        }

        async function fetchNextPage() {
          if (!hasMorePages) return;
          currentPage++;
          user = document.getElementById('userSelector').value;
          artist = document.getElementById('artistSelector').value;
          sort = document.getElementById('sortSelector').value;
          view = document.getElementById('viewSelector').value;
          server = document.getElementById('serverSelector').value;
          tag = document.getElementById('tagSelector').value;

          collectedSelector = document.getElementById('collectedSelector');
          collected = (collectedSelector !== null) ? collectedSelector.value : undefined;

          const lastGridElement = document.getElementById('gridContainer').lastElementChild;
          const lastTableElement = document.getElementById('tableContainerBody').lastElementChild;
          if (lastGridElement) observer.unobserve(lastGridElement);
          else if (lastTableElement) observer.unobserve(lastTableElement);
          await fetchMaps(currentPage, user, artist, sort, view, server, tag, collected, randomSeed);
        }

        // Fetch more carousel slides as the active slide nears the end of what's loaded, so
        // browsing forward keeps surfacing fresh content instead of just looping the same
        // few slides. Once the whole dataset has been fetched, start over from page 1. The
        // carousel itself also has wrap:true as a fallback so it never stalls even if a
        // fetch is still in flight when the last loaded slide is reached.
        function queueMoreCarouselIfNeeded() {
          if (carouselFetchInFlight) return;

          const carouselInner = document.querySelector('#carouselContainer .carousel-inner');
          const items = Array.from(carouselInner.children);
          const activeIndex = items.findIndex(item => item.classList.contains('active'));
          const remaining = items.length - 1 - activeIndex;
          if (remaining > 3) return;

          if (!hasMorePages) {
            currentPage = 0;
            hasMorePages = true;
          }

          carouselFetchInFlight = true;
          fetchNextPage().finally(() => {
            carouselFetchInFlight = false;
          });
        }

        // Initialize (or reinitialize with a new speed) the carousel view. wrap:true so it
        // loops back to the first loaded slide if it ever catches up to the end of what's
        // been fetched, rather than stalling.
        function initCarousel(interval) {
          const $carousel = $('#carouselContainer');
          if ($carousel.data('bs.carousel')) {
            $carousel.carousel('dispose');
          }
          $carousel.carousel({ interval, wrap: true });
          $carousel.carousel('cycle');
        }

        // Call the function to populate selectors and fetch initial data when the page loads
        document.addEventListener('DOMContentLoaded', () => {
          $('select').selectpicker();

          populateUserSelector();
          populateArtistSelector();
          populateSortSelector();
          populateCollectedSelector();
          populateServerSelector();
          populateTagSelector();
          // Initial API call on page load
          fetchMaps();
          fetchMapsCount();

          $('#carouselContainer').on('slid.bs.carousel', queueMoreCarouselIfNeeded);
          $('#carouselContainer').on('slid.bs.carousel', updateCarouselPositionDisplay);
          document.getElementById('carouselSpeedSelector').addEventListener('change', () => {
            initCarousel(getCarouselInterval());
          });
        });

      // Grid container for images
      div#gridContainer.row.mb-4

      div#carouselContainer.carousel.slide.mb-4(style='display:none; position: relative;')
        .carousel-inner
        span#carouselPositionDisplay.badge.badge-dark(style='position: absolute; bottom: 10px; right: 10px; z-index: 15; font-size: 1rem;')
        a.carousel-control-prev(href='#carouselContainer', role='button', data-slide='prev')
          span.carousel-control-prev-icon(aria-hidden='true')
          span.sr-only Previous
        a.carousel-control-next(href='#carouselContainer', role='button', data-slide='next')
          span.carousel-control-next-icon(aria-hidden='true')
          span.sr-only Next

      table#tableContainer.table.table-striped(style='display: none;')
        thead
          tr
            th #
            th Name
            th Server
            th Image
            th Artist
            th Size
            th Tags
            th Views
            th Likes

        tbody(id='tableContainerBody')

      // Keep loadingSpinner at bottom of page
      script.
        function createLoadingSpinner() {
          const loadingSpinner = document.createElement('div');
          loadingSpinner.id = 'loadingSpinner';
          loadingSpinner.className = 'text-center mt-4';
          
          const spinnerIcon = document.createElement('i');
          spinnerIcon.className = 'fa fa-spinner fa-spin fa-3x';
          
          const loadingText = document.createElement('p');
          loadingText.textContent = 'Loading...';
          
          loadingSpinner.appendChild(spinnerIcon);
          loadingSpinner.appendChild(loadingText);
          
          return loadingSpinner;
        }

        const container = document.querySelector('.container');
        const loadingSpinner = createLoadingSpinner();
        container.appendChild(loadingSpinner);

        // Function to toggle visibility of selectors
        function toggleSelectors() {
          const selectorsForm = document.getElementById('selectorsForm');
          const button = document.getElementById('toggleSelectorsButton');
          if (selectorsForm.style.display === 'none') {
            selectorsForm.style.display = 'block';
            button.textContent = 'Hide Filtering and Sorting';
          } else {
            selectorsForm.style.display = 'none';
            button.textContent = 'Show Filtering and Sorting';
          }
        }

        // Attach event listener to the button
        document.getElementById('toggleSelectorsButton').addEventListener('click', toggleSelectors);

